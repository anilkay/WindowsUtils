<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- UI text is English in code; Localization/Strings.tr.resx builds the tr satellite assembly. -->
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsUtils.Core\WindowsUtils.Core.csproj" />
    <ProjectReference Include="..\WindowsUtils.AI\WindowsUtils.AI.csproj" />
  </ItemGroup>

</Project>